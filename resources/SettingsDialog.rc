#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "SettingsControlIds.h"

IDI_TASKBAR ICON "HideYourTaskbar.ico"

IDD_SETTINGS DIALOGEX 0, 0, 440, 240
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Hide Your Taskbar"
FONT 10, "Segoe UI"
BEGIN
    LTEXT "Appearance", -1, 15, 19, 102, 14
    CONTROL "Default", IDC_NORMAL_DEFAULT, "Button", BS_OWNERDRAW | WS_TABSTOP, 11, 42, 105, 28
    CONTROL "Transparent", IDC_NORMAL_CLEAR, "Button", BS_OWNERDRAW | WS_TABSTOP, 11, 75, 105, 28
    CONTROL "Blur", IDC_NORMAL_BLUR, "Button", BS_OWNERDRAW | WS_TABSTOP, 11, 108, 105, 28
    CONTROL "Color", IDC_NORMAL_COLOR, "Button", BS_OWNERDRAW | WS_TABSTOP, 11, 141, 105, 28
    CONTROL "Advanced settings", IDC_ADVANCED, "Button", BS_OWNERDRAW | WS_TABSTOP, 11, 201, 105, 26
    LTEXT "Transparent", IDC_TITLE, 144, 18, 277, 25
    LTEXT "", IDC_MODE_DESCRIPTION, 145, 49, 274, 24
    CONTROL "Taskbar preview", IDC_MODE_PREVIEW, "Static", SS_OWNERDRAW, 144, 79, 277, 66
    CONTROL "Choose color", IDC_COLOR, "Button", BS_OWNERDRAW | WS_TABSTOP, 144, 161, 131, 29
    LTEXT "Opacity", IDC_OPACITY_LABEL, 290, 159, 80, 12
    CONTROL "86%", IDC_OPACITY_VALUE, "Static", SS_OWNERDRAW, 378, 159, 43, 12
    CONTROL "Opacity", IDC_OPACITY, TRACKBAR_CLASS, TBS_HORZ | TBS_NOTICKS | TBS_TRANSPARENTBKGND | WS_TABSTOP, 287, 172, 137, 18
    CONTROL "Maximized or full screen", IDC_FULL_ENABLED, "Button", BS_OWNERDRAW | WS_TABSTOP, 144, 79, 277, 27
    CONTROL "Default", IDC_FULL_DEFAULT, "Button", BS_OWNERDRAW | WS_TABSTOP, 144, 114, 65, 26
    CONTROL "Transparent", IDC_FULL_CLEAR, "Button", BS_OWNERDRAW | WS_TABSTOP, 214, 114, 68, 26
    CONTROL "Blur", IDC_FULL_BLUR, "Button", BS_OWNERDRAW | WS_TABSTOP, 287, 114, 65, 26
    CONTROL "Color", IDC_FULL_COLOR, "Button", BS_OWNERDRAW | WS_TABSTOP, 357, 114, 64, 26
    CONTROL "Start with Windows", IDC_STARTUP, "Button", BS_OWNERDRAW | WS_TABSTOP, 144, 202, 277, 27
END

IDD_COLOR_PICKER DIALOGEX 0, 0, 250, 205
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Choose color"
FONT 10, "Segoe UI"
BEGIN
    CONTROL "Saturation and brightness", IDC_COLOR_FIELD, "Static", SS_NOTIFY | WS_TABSTOP, 14, 14, 222, 102
    CONTROL "Hue", IDC_COLOR_HUE, "Static", SS_NOTIFY | WS_TABSTOP, 14, 123, 222, 14
    LTEXT "&HEX", -1, 14, 150, 24, 11
    CONTROL "", IDC_COLOR_HEX, "Edit", ES_LEFT | ES_AUTOHSCROLL | WS_TABSTOP, 43, 147, 89, 17
    CONTROL "Selected color", IDC_COLOR_PREVIEW, "Static", SS_NOTIFY, 141, 147, 95, 17
    LTEXT "", IDC_COLOR_HINT, 14, 168, 222, 11
    CONTROL "Cancel", IDCANCEL, "Button", BS_OWNERDRAW | WS_TABSTOP, 110, 181, 59, 16
    CONTROL "Apply", IDOK, "Button", BS_OWNERDRAW | WS_TABSTOP, 177, 181, 59, 16
END

